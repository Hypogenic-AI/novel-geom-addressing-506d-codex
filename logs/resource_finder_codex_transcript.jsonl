{"type":"item.started","item":{"id":"item_120","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\nfrom zipfile import ZipFile\nfrom pathlib import Path\nimport json, random\nzip_path=Path('datasets/bongard_logo/bongard_logo_dataset.zip')\nsample_dir=Path('datasets/bongard_logo/samples')\nsample_dir.mkdir(parents=True, exist_ok=True)\nwith ZipFile(zip_path) as zf:\n    infos=zf.infolist()\n    pngs=[i.filename for i in infos if i.filename.endswith('.png') and not i.filename.startswith('__MACOSX/')]\n    jsons=[i.filename for i in infos if i.filename.endswith('.json') and not i.filename.startswith('__MACOSX/')]\n    summary={'zip_file':str(zip_path),'entries':len(infos),'png_images':len(pngs),'json_files':jsons,'compressed_bytes':zip_path.stat().st_size,'uncompressed_bytes':sum(i.file_size for i in infos)}\n    (sample_dir/'archive_summary.json').write_text(json.dumps(summary, indent=2))\n    for js in jsons[:4]:\n        data=zf.read(js)\n        out=sample_dir/Path(js).name\n        # save only a small prefix for huge action-program jsons, full split json is small enough.\n        if len(data)>200000:\n            try:\n                obj=json.loads(data)\n                if isinstance(obj, dict):\n                    small=dict(list(obj.items())[:3])\n                elif isinstance(obj, list):\n                    small=obj[:3]\n                else:\n                    small=obj\n                out.write_text(json.dumps(small, indent=2)[:200000])\n            except Exception:\n                out.write_bytes(data[:200000])\n        else:\n            out.write_bytes(data)\n    for name in pngs[:6]:\n        out=sample_dir/Path(name).name\n        out.write_bytes(zf.read(name))\nprint('sampled bongard logo archive')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
