{"type":"item.started","item":{"id":"item_108","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\nfrom pathlib import Path\nimport csv, json, os, random, requests, shutil\n\nroot = Path('datasets')\nsummary = {}\n\ndef write_json(path, obj):\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(obj, indent=2, ensure_ascii=False))\n\n# PuzzleVQA\npuzzle_files = sorted((root/'puzzlevqa').glob('*.json'))\npuzzle_counts = {}\npuzzle_samples = []\nfor pf in puzzle_files:\n    n=0\n    with pf.open() as f:\n        for line in f:\n            if not line.strip():\n                continue\n            rec=json.loads(line)\n            n+=1\n            if len(puzzle_samples)<5:\n                puzzle_samples.append(rec)\n    puzzle_counts[pf.name]=n\nsummary['puzzlevqa']={'files':len(puzzle_files),'records':sum(puzzle_counts.values()),'per_file_minmax':[min(puzzle_counts.values()),max(puzzle_counts.values())]}\nwrite_json(root/'puzzlevqa/samples/sample_records.json', puzzle_samples)\n\n# Bongard-RWR\nproblem_dirs=sorted([p for p in (root/'bongard_rwr').iterdir() if p.is_dir()], key=lambda p: int(p.name) if p.name.isdigit() else 9999)\nbongard_samples=[]\nfor p in problem_dirs[:5]:\n    bongard_samples.append({'problem_id':p.name,'files':sorted(str(x.relative_to(p)) for x in p.rglob('*') if x.is_file())[:20]})\nsummary['bongard_rwr']={'problems':len(problem_dirs),'sample_problem_ids':[p.name for p in problem_dirs[:10]]}\nwrite_json(root/'bongard_rwr/samples/sample_index.json', bongard_samples)\n\n# Shape-Blind\ncsv_dir=root/'shape_blind/CSVs_for_evaluation'\nshape_csvs=sorted(csv_dir.glob('*.csv'))\nshape_summary={}\nshape_samples={}\nfor cf in shape_csvs:\n    with cf.open(newline='') as f:\n        rows=list(csv.DictReader(f))\n    shape_summary[cf.name]={'rows':len(rows),'columns':list(rows[0].keys()) if rows else []}\n    shape_samples[cf.name]=rows[:3]\nimage_count=sum(1 for p in (root/'shape_blind').rglob('*.png'))\nsummary['shape_blind']={'csvs':shape_summary,'png_images':image_count}\nwrite_json(root/'shape_blind/samples/sample_records.json', shape_samples)\n\n# VSR\nvsr_base=root/'visual_spatial_reasoning/splits/random'\nvsr_counts={}\nvsr_samples=[]\nfor split in ['train','dev','test']:\n    fp=vsr_base/f'{split}.jsonl'\n    n=0\n    with fp.open() as f:\n        for line in f:\n            if not line.strip(): continue\n            rec=json.loads(line); n+=1\n            if len(vsr_samples)<10:\n                vsr_samples.append(rec)\n    vsr_counts[split]=n\nsummary['visual_spatial_reasoning']={'random_split_counts':vsr_counts}\nwrite_json(root/'visual_spatial_reasoning/samples/sample_records.json', vsr_samples[:5])\n# Download a tiny image sample for local inspection.\nimg_dir=root/'visual_spatial_reasoning/samples/images'\nimg_dir.mkdir(parents=True, exist_ok=True)\nfor rec in vsr_samples[:10]:\n    out=img_dir/rec['image']\n    if out.exists() and out.stat().st_size>1000:\n        continue\n    try:\n        resp=requests.get(rec['image_link'], timeout=20)\n        resp.raise_for_status()\n        out.write_bytes(resp.content)\n    except Exception as e:\n        print('sample image download failed', rec.get('image_link'), e)\n\n# VisuLogic\nvis_samples=[]\nwith (root/'visulogic/data.jsonl').open() as f:\n    n=0\n    for line in f:\n        if not line.strip(): continue\n        rec=json.loads(line); n+=1\n        if len(vis_samples)<5:\n            vis_samples.append(rec)\nsummary['visulogic']={'records':n,'images':sum(1 for _ in (root/'visulogic/images').glob('*.png'))}\nwrite_json(root/'visulogic/samples/sample_records.json', vis_samples)\n\n# Spatial-DISE CSV\nspatial_counts={}\nspatial_samples={}\nfor cf in sorted((root/'spatial_dise_csv').glob('**/*.csv')):\n    with cf.open(newline='') as f:\n        reader=csv.DictReader(f)\n        rows=[]\n        n=0\n        for row in reader:\n            n+=1\n            if len(rows)<3: rows.append(row)\n    rel=str(cf.relative_to(root/'spatial_dise_csv'))\n    spatial_counts[rel]=n\n    spatial_samples[rel]=rows\nsummary['spatial_dise_csv']={'csv_counts':spatial_counts,'example_files':sum(1 for _ in (root/'spatial_dise_csv/examples').glob('*'))}\nwrite_json(root/'spatial_dise_csv/samples/sample_records.json', spatial_samples)\n\nwrite_json(root/'samples/validation_summary.json', summary)\nprint(json.dumps(summary, indent=2)[:6000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
