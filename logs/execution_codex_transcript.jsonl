{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\nimport pandas as pd\nfrom scipy import stats\nimport numpy as np\ndf=pd.read_csv('results/evaluations/scored_responses.csv')\nwide=df.pivot_table(index=['task_id','query_id'], columns='prompt_style', values='correct', aggfunc='first')\nfor label, sub in [('all', wide), *[(gt, df[df.graph_type==gt].pivot_table(index=['task_id','query_id'], columns='prompt_style', values='correct', aggfunc='first')) for gt in sorted(df.graph_type.unique())]]:\n    d=sub.dropna()\n    direct=d['direct'].astype(bool).to_numpy(); reasoned=d['reasoned'].astype(bool).to_numpy()\n    reasoned_only=int((~direct & reasoned).sum()); direct_only=int((direct & ~reasoned).sum()); disc=reasoned_only+direct_only\n    p=1.0 if disc==0 else min(1, 2*stats.binom.cdf(min(reasoned_only,direct_only), disc, .5))\n    print(label, 'direct', direct.mean(), 'reasoned', reasoned.mean(), 'reasoned_only', reasoned_only, 'direct_only', direct_only, 'mcnemar_p', p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
